<mxfile host="drawio"><diagram id="fluxo" name="Fluxo de Trabalho"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TIT" value="&lt;b&gt;GWATER · Fluxo de Trabalho · REV 0.1.0&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;QGIS (cadastro) → EPANET (motor) → Centro de Operações (decisão e operação) · 8 fases concluídas em 24/10/2026 · azul = sequência · rosa tracejado = ciclos de melhoria&lt;/font&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/></mxCell><mxCell id="F0" value="FASE 0 · Prova de conceito&lt;br&gt;&lt;font style='font-size:10px' color='#1f7a4a'&gt;✓ CONCLUÍDA&lt;/font&gt;" style="swimlane;rounded=1;arcSize=5;startSize=48;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="290" height="420" as="geometry"/></mxCell><mxCell id="F0T0" value="&lt;b&gt;Modelo .inp do sistema da tela&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#55657a'&gt;modelo/sistema_cos.inp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="F0"><mxGeometry x="15" y="62" width="260" height="68" as="geometry"/></mxCell><mxCell id="F0T1" value="&lt;b&gt;Simulação 24 h no EPANET (WNTR)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#55657a'&gt;motor/simular.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="F0"><mxGeometry x="15" y="150" width="260" height="68" as="geometry"/></mxCell><mxCell id="E1" value="" style="endArrow=block;html=1;strokeColor=#888888;" edge="1" parent="F0" source="F0T0" target="F0T1"><mxGeometry relative="1" as="geometry